# Copy to .env after connecting this repository to its Trigger.dev project.
TRIGGER_SECRET_KEY=tr_dev_replace_me

# Keep preview tasks pointed at preview/sandbox destinations.
PULPSENSE_AUTOMATION_ENVIRONMENT=preview

# Twenty sandbox workspace
TWENTY_API_ORIGIN=https://api.twenty.com
TWENTY_API_KEY=
TWENTY_QUALIFIED_STAGE_VALUE=QUALIFIED_AWAITING_BOOKING
TWENTY_CALL_BOOKED_STAGE_VALUE=CALL_BOOKED
TWENTY_CLOSED_STAGE_VALUES=WON,LOST

# Lawyer Meta sandbox/test dataset. These override the legacy unsuffixed names.
META_GRAPH_API_VERSION=v26.0
META_PIXEL_ID_AI_SEO_L=
META_CAPI_ACCESS_TOKEN_AI_SEO_L=
META_TEST_EVENT_CODE_AI_SEO_L=

# PostHog lifecycle measurement (the project key is safe to expose)
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Redacted operational alerts for exhausted Twenty retries
SLACK_FAILURE_WEBHOOK_URL=
