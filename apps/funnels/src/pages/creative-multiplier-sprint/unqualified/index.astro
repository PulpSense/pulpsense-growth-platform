---
import { SprintThankYouPage } from "@/funnels/creative-multiplier-sprint/components/SprintThankYouPage";
import { FunnelAnalytics } from "@/components/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Application Received | Creative Multiplier Sprint"
  description="Your Creative Multiplier Sprint application has been received."
>
  <FunnelAnalytics
    client:interaction
    apiKey={import.meta.env.PUBLIC_POSTHOG_KEY}
    host={import.meta.env.PUBLIC_POSTHOG_HOST}
    funnelId="creative-multiplier-sprint"
    page="unqualified"
  />
  <SprintThankYouPage qualified={false} />
</BaseLayout>
