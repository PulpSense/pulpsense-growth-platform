---
import {
  CreativeMultiplierPage,
  VideoExamplesSection,
} from "@/app/creative-multiplier-sprint/_components/CreativeMultiplierPage";
import { ApplicationFormIsland } from "@/app/creative-multiplier-sprint/_components/ApplicationFormIsland";
import { DslCarousel } from "@/app/creative-multiplier-sprint/_components/DslCarousel";
import { MobileStickyCta } from "@/app/creative-multiplier-sprint/_components/MobileStickyCta";
import { DeferredLoopVideo } from "@/app/creative-multiplier-sprint/_components/DeferredLoopVideo";
import { createFormConfig } from "@/app/creative-multiplier-sprint/content";
import {
  createBrowserTrackingConfig,
  type DeploymentEnvironment,
} from "@/app/creative-multiplier-sprint/preview-config";
import { FunnelAnalytics, TrackingPixels } from "@/components/ui";
import type { PixelConfig } from "@/components/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";

const rawEnvironment = import.meta.env.PUBLIC_PULPSENSE_ENVIRONMENT ?? "local";
if (!["local", "preview", "production"].includes(rawEnvironment)) {
  throw new Error(
    `Unsupported PUBLIC_PULPSENSE_ENVIRONMENT: ${rawEnvironment}`,
  );
}
const deploymentEnvironment = rawEnvironment as DeploymentEnvironment;
const previewPixels = createBrowserTrackingConfig({
  environment: deploymentEnvironment,
  metaPixelId: import.meta.env.PUBLIC_META_PIXEL_ID,
}) satisfies PixelConfig;
const formConfig = createFormConfig({
  environment: deploymentEnvironment,
  calLink: import.meta.env.PUBLIC_CAL_LINK,
  calNamespace: import.meta.env.PUBLIC_CAL_NAMESPACE,
});
---

<BaseLayout
  title="Creative Multiplier Sprint | 10 AI Avatar Videos in 2 Business Days"
  description="Turn one proven paid-social ad into 10 ready-to-test AI avatar videos in 2 business days. Built for ecommerce brands with winning creatives."
  openGraphTitle="Creative Multiplier Sprint | PulpSense"
  openGraphDescription="Same winning ad. 10 new AI avatar videos. Delivered ready to test in 2 business days."
>
  <FunnelAnalytics
    client:interaction="idle"
    apiKey={import.meta.env.PUBLIC_POSTHOG_KEY}
    host={import.meta.env.PUBLIC_POSTHOG_HOST}
    funnelId="creative-multiplier-sprint"
    page="landing"
  />
  <CreativeMultiplierPage>
    <TrackingPixels
      slot="tracking"
      pixels={previewPixels}
      interactionReady
      client:interaction="idle"
    />
    <DslCarousel slot="carousel" client:interaction />
    <VideoExamplesSection slot="proof" client:visible />
    <ApplicationFormIsland
      slot="form"
      config={formConfig}
      turnstileSiteKey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}
      client:visible
    />
    <MobileStickyCta slot="sticky-cta" client:interaction />
    <DeferredLoopVideo
      slot="desktop-avatar-video"
      client:interaction
      interactionReady
      src="/creative-multiplier-sprint/videos/ugc-example-01-loop.mp4"
      poster="/creative-multiplier-sprint/images/ugc-example-01.webp"
      label="Authority-led hook"
      className="absolute inset-0 h-full w-full object-cover"
    />
    <DeferredLoopVideo
      slot="mobile-avatar-video"
      client:interaction
      interactionReady
      src="/creative-multiplier-sprint/videos/ugc-example-01-loop.mp4"
      poster="/creative-multiplier-sprint/images/ugc-example-01.webp"
      label="Authority-led hook"
      className="absolute inset-0 h-full w-full object-cover"
    />
  </CreativeMultiplierPage>
</BaseLayout>
