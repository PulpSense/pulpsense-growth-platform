    <script is:inline>
      /* Review lightbox + carousel auto-advance (same behavior as the thank-you page). */
      (function () {
        var box = document.getElementById('pr-lightbox');
        var boxImg = document.getElementById('pr-lightbox-img');
        var closeBtn = document.getElementById('pr-lightbox-close');
        if (box && boxImg && closeBtn) {
          var open = function (img) {
            boxImg.src = img.src.replace('/r_800/', '/r_1200/');
            boxImg.alt = img.alt;
            box.hidden = false;
            document.body.style.overflow = 'hidden';
          };
          var close = function () {
            box.hidden = true;
            boxImg.src = '';
            document.body.style.overflow = '';
          };
          document
            .querySelectorAll('.pr-review-card img')
            .forEach(function (img) {
              img
                .closest('.pr-review-card')
                .addEventListener('click', function () {
                  open(img);
                });
            });
          box.addEventListener('click', function (e) {
            if (e.target !== boxImg) close();
          });
          closeBtn.addEventListener('click', close);
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !box.hidden) close();
          });
        }
        var track = document.getElementById('pr-reviews-track');
        if (!track) return;
        var stopped = false;
        var idx = 0;
        ['pointerdown', 'wheel', 'touchstart', 'keydown'].forEach(function (ev) {
          track.addEventListener(
            ev,
            function () {
              stopped = true;
            },
            { passive: true },
          );
        });
        setInterval(function () {
          if (stopped || track.scrollWidth <= track.clientWidth + 8) return;
          var cards = track.children;
          if (!cards.length) return;
          idx = (idx + 1) % cards.length;
          track.scrollTo({
            left: cards[idx].offsetLeft - cards[0].offsetLeft,
            behavior: 'smooth',
          });
        }, 4000);
      })();
    </script>
    <script is:inline>
      /* Skip-the-call rail: carry any typed contact info onto /start (pixel
         advanced matching + /onboarding prefill downstream) and log which
         placement was clicked. */
      (function () {
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('.pr-skip-call');
          if (!a) return;
          var placement = a.getAttribute('data-skip-call') || 'unknown';
          try {
            var u = new URL(a.getAttribute('href'), location.origin);
            var email = (document.getElementById('pr-tf-email') || {}).value;
            var phone = (document.getElementById('pr-tf-phone') || {}).value;
            var first = (document.getElementById('pr-tf-first') || {}).value;
            var last = (document.getElementById('pr-tf-last') || {}).value;
            if (email) u.searchParams.set('email', email.trim());
            if (phone) u.searchParams.set('phone', phone.trim());
            if (first) u.searchParams.set('first_name', first.trim());
            if (last) u.searchParams.set('last_name', last.trim());
            u.searchParams.set('src', placement);
            a.href = u.toString();
          } catch (err) {}
          if (window.fbq) fbq('trackCustom', 'SkipCallClick', { placement: placement });
          if (window.posthog && posthog.capture)
            posthog.capture('start_trial_click', { placement: placement });
        });
      })();
    </script>
