    <script is:inline>
      (function () {
        var root = document.getElementById('pr-ghl-funnel');
        if (!root) return;
        var sticky = root.querySelector('.pr-sticky-cta');
        var form = document.getElementById('pr-funnel-form');
        if (!sticky || !form) return;
        root.classList.add('pr-has-sticky');
        var formVisible = false;
        var scrolledPast = false;
        function update() {
          if (scrolledPast && !formVisible) {
            sticky.classList.add('is-visible');
            sticky.setAttribute('aria-hidden', 'false');
          } else {
            sticky.classList.remove('is-visible');
            sticky.setAttribute('aria-hidden', 'true');
          }
        }
        if ('IntersectionObserver' in window) {
          new IntersectionObserver(
            function (entries) {
              formVisible = entries[0].isIntersecting;
              update();
            },
            { threshold: 0.05 },
          ).observe(form);
        }
        var threshold = window.innerHeight * 0.6;
        function onScroll() {
          scrolledPast = window.scrollY > threshold;
          update();
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', function () {
          threshold = window.innerHeight * 0.6;
          onScroll();
        });
        onScroll();
      })();
    </script>
    <script is:inline>
      (function () {
        var HYROS_PIXEL_ID =
          '2bda9dc716c049aebc7d7f1b4bcc69851cc12fbc2f38ea9a0393641d147cf09d';
        var HYROS_LEAD_TAG = '!local-lead';
        var BOOKING_BASE =
          'https://api.leadconnectorhq.com/widget/booking/1iV5qF8CybDgaaa1WhAz';
        /** GHL inbound webhook — only POSTed when the lead qualifies (business owner). */
        var WEBHOOK_QUALIFIED_URL =
          'https://services.leadconnectorhq.com/hooks/tWiE0Ug2tX6WnYeFUXM2/webhook-trigger/737b6b13-16c6-4733-b9ae-cf589a81abe0';

        var steps = {
          contact: document.getElementById('pr-tf-step-contact'),
          owner: document.getElementById('pr-tf-step-owner'),
          calendar: document.getElementById('pr-tf-step-calendar'),
          no: document.getElementById('pr-tf-step-no'),
        };
        var label = document.getElementById('pr-tf-step-label');
        var fill = document.getElementById('pr-tf-progress-fill');
        var iframe = document.getElementById('pr-tf-booking-iframe');
        var funnelRoot = document.getElementById('pr-ghl-funnel');
        if (!steps.contact || !label || !fill || !iframe) return;

        var lead = null;
        /** Reset whenever the contact step is shown (anti-bot timing). */
        var contactStepAt = Date.now();
        /** Avoid duplicate webhook if user revisits the qualifier without editing contact. */
        var qualifiedWebhookSent = false;

        /* posthog.capture/identify don't exist until the deferred init runs after window
           load — the qualifier is now step 1, so a fast click can beat it. Queue and flush. */
        var phQueue = [];
        function ph(method) {
          var args = Array.prototype.slice.call(arguments, 1);
          if (window.posthog && typeof posthog[method] === 'function') {
            posthog[method].apply(posthog, args);
          } else {
            phQueue.push([method, args]);
          }
        }
        window.addEventListener('load', function () {
          setTimeout(function () {
            phQueue.forEach(function (q) {
              if (window.posthog && typeof posthog[q[0]] === 'function') {
                posthog[q[0]].apply(posthog, q[1]);
              }
            });
            phQueue = [];
          }, 0);
        });

        function showStep(stepEl) {
          ['contact', 'owner', 'calendar', 'no'].forEach(function (k) {
            steps[k].classList.remove('is-active');
          });
          stepEl.classList.add('is-active');
          if (funnelRoot) {
            if (stepEl === steps.calendar) {
              funnelRoot.classList.add('pr-calendar-active');
            } else {
              funnelRoot.classList.remove('pr-calendar-active');
            }
          }
          if (stepEl === steps.contact) {
            contactStepAt = Date.now();
            qualifiedWebhookSent = false;
          }
        }

        function setProgress(cur, total) {
          label.textContent = 'Step ' + cur + ' of ' + total;
          fill.style.width = (100 * (cur / total)).toFixed(2) + '%';
        }

        function fireHyrosLead(email, phone) {
          var s = document.createElement('script');
          s.async = true;
          s.src =
            'https://t.leadoracle.ai/v1/lst/universal-script?ph=' +
            HYROS_PIXEL_ID +
            '&tag=' +
            encodeURIComponent(HYROS_LEAD_TAG) +
            '&email=' +
            encodeURIComponent(email) +
            '&phone=' +
            encodeURIComponent(phone || '') +
            '&ref_url=' +
            encodeURIComponent(document.URL);
          document.head.appendChild(s);
        }

        /** GHL embed helper — loaded only when user opens the calendar (qualified lead). */
        var formEmbedScriptPromise = null;

        function loadFormEmbedScript() {
          if (formEmbedScriptPromise) {
            return formEmbedScriptPromise;
          }
          if (document.querySelector('script[data-pr-form-embed]')) {
            formEmbedScriptPromise = Promise.resolve();
            return formEmbedScriptPromise;
          }
          formEmbedScriptPromise = new Promise(function (resolve) {
            var s = document.createElement('script');
            s.src = 'https://link.msgsndr.com/js/form_embed.js';
            s.async = true;
            s.setAttribute('data-pr-form-embed', '1');
            s.onload = function () {
              resolve();
            };
            s.onerror = function () {
              resolve();
            };
            document.body.appendChild(s);
          });
          return formEmbedScriptPromise;
        }

        function sendQualifiedLeadWebhook(l, owner, fastSubmit) {
          if (qualifiedWebhookSent) return;
          qualifiedWebhookSent = true;
          fireHyrosLead(l.email, l.phone);
          /* Meta Lead event — feeds FB's optimizer the same qualified-lead signal as Hyros. */
          if (window.fbq) {
            fbq('track', 'Lead');
          }
          ph('capture', 'qualified_lead', { fast_submit: !!fastSubmit });
          var payload = new URLSearchParams({
            first_name: l.first,
            last_name: l.last,
            email: l.email,
            phone: l.phone,
            business_owner: owner,
            qualified: 'yes',
            fast_submit: fastSubmit ? 'yes' : 'no',
            source: 'local-business-booking-funnel-ai-seo',
            page_url: document.URL,
            referrer: document.referrer || '',
          });
          fetch(WEBHOOK_QUALIFIED_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: payload.toString(),
            keepalive: true,
          }).catch(function () {});
        }

        var CONTACT_MIN_MS = 2000;

        var DISPOSABLE_DOMAINS = {
          'mailinator.com': 1,
          'mailinator2.com': 1,
          'guerrillamail.com': 1,
          'guerrillamailblock.com': 1,
          'sharklasers.com': 1,
          'yopmail.com': 1,
          'yopmail.fr': 1,
          'tempmail.com': 1,
          'temp-mail.org': 1,
          'tempmail.net': 1,
          '10minutemail.com': 1,
          '10minutemail.net': 1,
          'throwaway.email': 1,
          'trashmail.com': 1,
          'fakeinbox.com': 1,
          'getnada.com': 1,
          'mohmal.com': 1,
          'dispostable.com': 1,
          'emailondeck.com': 1,
          'burnermail.io': 1,
          'maildrop.cc': 1,
          'mailnesia.com': 1,
          'mintemail.com': 1,
          'mytemp.email': 1,
          'spam4.me': 1,
          'grr.la': 1,
          'pokemail.net': 1,
          'inboxkitten.com': 1,
          'tmpmail.org': 1,
          'tmpmail.net': 1,
          'mailcatch.com': 1,
          'discard.email': 1,
          'trashmail.de': 1,
          'mailnull.com': 1,
          'spamgourmet.com': 1,
          'jetable.org': 1,
          'nwytg.net': 1,
        };

        function normalizeUSPhoneDigits(phone) {
          var d = phone.replace(/\D/g, '');
          if (d.length === 11 && d.charAt(0) === '1') {
            d = d.slice(1);
          }
          return d;
        }

        /** Basic NANP checks — blocks obvious fakes; not a carrier lookup. */
        function isPlausibleUSPhone(d) {
          if (d.length !== 10) return false;
          if (d.charAt(0) < '2' || d.charAt(0) > '9') return false;
          if (d.charAt(3) < '2' || d.charAt(3) > '9') return false;
          if (/^(\d)\1{9}$/.test(d)) return false;
          if (d.slice(0, 3) === '555' && d.slice(3, 5) === '01') return false;
          return true;
        }

        function disposableEmailDomain(email) {
          var at = email.lastIndexOf('@');
          if (at < 1) return false;
          var domain = email.slice(at + 1).toLowerCase();
          return !!DISPOSABLE_DOMAINS[domain];
        }

        function suspiciousEmail(email) {
          var lower = email.toLowerCase();
          var at = lower.lastIndexOf('@');
          if (at < 1) return true;
          var local = lower.slice(0, at);
          var domain = lower.slice(at + 1);
          if (local.length < 3) return true;
          if (disposableEmailDomain(lower)) return true;
          if (
            /^(test|asdf|qwerty|fake|none|noemail|invalid)\d*$/i.test(local)
          ) {
            return true;
          }
          if (/\+{2,}|\.{5,}/.test(local)) return true;
          if (!/^[a-z0-9._%+-]+$/i.test(local)) return true;
          return !domain.includes('.');
        }

        function suspiciousName(s) {
          if (!s || s.length < 2) return true;
          if (/https?:|@|www\.|<|>|\[|\]|\{|\}/i.test(s)) return true;
          if (/^\d+$/.test(s)) return true;
          if (/^(.)\1{4,}$/i.test(s)) return true;
          return false;
        }

        /** Prefill GHL / LeadConnector booking widget via query string (same as public calendar links). */
        function buildBookingSrc(first, last, email, phone) {
          var u = new URL(BOOKING_BASE);
          var full = (first + ' ' + last).trim();
          u.searchParams.set('email', email);
          u.searchParams.set('phone', phone);
          u.searchParams.set('mobile', phone);
          u.searchParams.set('full_name', full);
          u.searchParams.set('first_name', first);
          u.searchParams.set('last_name', last);
          return u.toString();
        }

        function tryContactContinue() {
          var err = document.getElementById('pr-tf-err-contact');
          err.textContent = '';
          var hp = document.getElementById('pr-tf-website');
          if (hp && hp.value.replace(/\s/g, '') !== '') {
            return;
          }
          /* Autofill users legitimately finish in <2s — flag for spam scoring instead of blocking. */
          var fastSubmit = Date.now() - contactStepAt < CONTACT_MIN_MS;
          var first = document.getElementById('pr-tf-first').value.trim();
          var last = document.getElementById('pr-tf-last').value.trim();
          var email = document.getElementById('pr-tf-email').value.trim();
          var phone = document.getElementById('pr-tf-phone').value.trim();
          if (!first) {
            err.textContent = 'Please enter your first name.';
            return;
          }
          if (suspiciousName(first) || (last && suspiciousName(last))) {
            err.textContent = 'Please enter a real name.';
            return;
          }
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            err.textContent = 'Please enter a valid email address.';
            return;
          }
          if (suspiciousEmail(email)) {
            err.textContent =
              'Please use a real business email (temporary inboxes are not accepted).';
            return;
          }
          var digits = normalizeUSPhoneDigits(phone);
          if (digits.length !== 10 || !isPlausibleUSPhone(digits)) {
            err.textContent =
              'Please enter a valid U.S. mobile or business number (10 digits).';
            return;
          }

          lead = { first: first, last: last, email: email, phone: phone };
          ph('identify', email, {
            email: email,
            phone: phone,
            name: (first + ' ' + last).trim(),
          });
          ph('capture', 'contact_submitted', { fast_submit: fastSubmit });
          sendQualifiedLeadWebhook(lead, 'yes', fastSubmit);
          loadFormEmbedScript().then(function () {
            iframe.src = buildBookingSrc(
              lead.first,
              lead.last,
              lead.email,
              lead.phone,
            );
            showStep(steps.calendar);
            ph('capture', 'calendar_shown');
            setProgress(3, 3);
            requestAnimationFrame(function () {
              steps.calendar.scrollIntoView({
                block: 'start',
                behavior: 'auto',
              });
            });
          });
        }

        var contactForm = document.getElementById('pr-tf-contact-form');
        if (contactForm) {
          contactForm.addEventListener('submit', function (e) {
            e.preventDefault();
            tryContactContinue();
          });
        }

        document
          .getElementById('pr-tf-back-contact')
          .addEventListener('click', function () {
            showStep(steps.owner);
            setProgress(1, 3);
          });

        document.querySelectorAll('[data-owner]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var owner = btn.getAttribute('data-owner');
            ph('capture', 'owner_answered', { owner: owner });
            if (owner === 'yes') {
              showStep(steps.contact);
              setProgress(2, 3);
              /* Warm GHL embed script while they fill in their details — the calendar then feels instant. */
              loadFormEmbedScript();
            } else {
              ph('capture', 'not_owner');
              showStep(steps.no);
              label.textContent = 'Thanks for letting us know';
              fill.style.width = '100%';
            }
          });
        });

        document
          .getElementById('pr-tf-back-cal')
          .addEventListener('click', function () {
            showStep(steps.contact);
            setProgress(2, 3);
          });

        document
          .getElementById('pr-tf-back-no')
          .addEventListener('click', function () {
            showStep(steps.owner);
            setProgress(1, 3);
          });

        /* CTA anchors: lazy images above the form can grow the page mid-scroll,
           so the native anchor jump lands short — re-anchor once scrolling settles. */
        var formSection = document.getElementById('pr-funnel-form');
        document
          .querySelectorAll('a[href="#pr-funnel-form"]')
          .forEach(function (a) {
            a.addEventListener('click', function (e) {
              if (!formSection) return;
              e.preventDefault();
              formSection.scrollIntoView({ behavior: 'smooth' });
              var lastY = -1;
              var still = 0;
              var deadline = Date.now() + 3000;
              (function settle() {
                if (Date.now() > deadline) return;
                var y = window.scrollY;
                still = y === lastY ? still + 1 : 0;
                lastY = y;
                if (still >= 12) {
                  /* Landed short? (scroll-margin leaves ~24px; allow slack.) */
                  if (formSection.getBoundingClientRect().top > 40) {
                    formSection.scrollIntoView({ behavior: 'smooth' });
                  }
                  return;
                }
                requestAnimationFrame(settle);
              })();
            });
          });

        setProgress(1, 3);
      })();
    </script>
    <div class="pr-lightbox" id="pr-lightbox" hidden>
      <button class="pr-lightbox-close" id="pr-lightbox-close" aria-label="Close enlarged review">
        ×
