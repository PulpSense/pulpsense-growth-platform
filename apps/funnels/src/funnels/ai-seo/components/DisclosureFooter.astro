---
import type { GuaranteeTermsContent } from "../campaign-config/types";

type Props = { guaranteeTerms?: GuaranteeTermsContent | null };

const { guaranteeTerms } = Astro.props;
---

<section class="pr-footer">
  <div class="pr-container pr-container-md">
    <div>
      <strong>Important Disclosures</strong>
      <p style="margin: 0.25rem 0 0">
        All testimonials, statistics, and case study results referenced on this
        site reflect specific client outcomes. Individual results vary based on
        industry, market, current online presence, and execution. Past results
        do not guarantee future performance. PulpSense makes no representation
        that you will achieve the same or similar results.
      </p>
      {
        guaranteeTerms && (
          <p style="margin: 0.75rem 0 0">
            <strong>{guaranteeTerms.heading}:</strong>{" "}
            {guaranteeTerms.items.join(" ")}
          </p>
        )
      }
    </div>
    <div
      style="
              margin-top: 1rem;
              padding-top: 1rem;
              border-top: 1px solid var(--pr-border);
            "
    >
      This site is not a part of the Facebook™ website or Facebook™ Inc.
      Additionally, this site is NOT endorsed by Facebook™ in any way. FACEBOOK™
      is a trademark of FACEBOOK™, Inc.
    </div>
  </div>
</section>
