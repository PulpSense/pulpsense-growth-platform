---
import { AiSeoQualificationForm } from "@/funnels/ai-seo/components/AiSeoQualificationForm";
import type { AiSeoFunnelId } from "@/funnels/ai-seo/campaigns";
import type { ApplicationPageContent } from "../../campaign-config";

type Props = {
  content: ApplicationPageContent;
  funnelId: AiSeoFunnelId;
  qualifiedRedirect: string;
  calLink: string;
  calNamespace?: string;
  turnstileSiteKey?: string;
};

const {
  content,
  funnelId,
  qualifiedRedirect,
  calLink,
  calNamespace,
  turnstileSiteKey,
} = Astro.props;
---

<section class="pr-section pr-section-gray" id="pr-funnel-form">
  <div class="pr-container pr-center">
    <header class="pr-application-intro">
      {
        content.badge && (
          <div class="pr-badge">
            <span class="pr-stars" aria-hidden="true">
              ★★★★★
            </span>
            <span class="pr-badge-copy">{content.badge}</span>
          </div>
        )
      }
      <h1 class="pr-h2" style="font-size: clamp(1.65rem, 4vw, 2.75rem)">
        <span style="color: var(--pr-blue)">{content.promise}</span>{" "}in{" "}
        <span style="color: var(--pr-blue)">{content.timeframe}</span>{
          content.titleSeparator
        }{content.titleSuffix}
      </h1>
      <p class="pr-sub pr-form-intro">
        {content.intro}
      </p>
      {
        content.guaranteeTerms && (
          <div class="pr-application-guarantee-terms">
            <h2>{content.guaranteeTerms.heading}</h2>
            <ul>
              {content.guaranteeTerms.items.map((term) => (
                <li>{term}</li>
              ))}
            </ul>
          </div>
        )
      }
    </header>
    <div class="pr-funnel-layout">
      <AiSeoQualificationForm
        client:visible
        funnelId={funnelId}
        calLink={calLink}
        calNamespace={calNamespace}
        turnstileSiteKey={turnstileSiteKey}
        qualifiedRedirect={qualifiedRedirect}
        qualification={content.qualification}
      />
      <aside class="pr-expect">
        <h3 class="pr-expect-title">{content.expectationHeading}</h3>
        <ul class="pr-expect-list">
          {
            content.expectations.map((expectation) => (
              <li class="pr-expect-item">
                <span class="pr-expect-check" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                </span>
                <p>
                  {expectation.before}
                  <strong>{expectation.emphasis}</strong>
                  {expectation.after}
                </p>
              </li>
            ))
          }
        </ul>
        <div class="pr-expect-callout">
          {content.callout}
        </div>
        {
          content.proofRating && content.proofLabel && (
            <div class="pr-expect-proof">
              <span class="pr-stars" aria-hidden="true">
                <svg class="pr-star" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
                <svg class="pr-star" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
                <svg class="pr-star" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
                <svg class="pr-star" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
                <svg class="pr-star" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
              </span>
              <span>
                <strong>{content.proofRating}</strong> {content.proofLabel}
              </span>
            </div>
          )
        }
      </aside>
    </div>
  </div>
</section>
