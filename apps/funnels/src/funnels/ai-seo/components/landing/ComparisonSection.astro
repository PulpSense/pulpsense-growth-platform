---
import type { LandingContent } from "../../campaign-config";

type Props = { content: LandingContent["comparison"] };

const { content } = Astro.props;
---

<!-- Comparison table -->
<section class="pr-section">
  <div class="pr-container pr-center">
    <h2 class="pr-h2">{content.heading}</h2>
    <p class="pr-sub">{content.intro}</p>
    <div class="pr-compare-wrap">
      <table class="pr-compare">
        <thead>
          <tr>
            {content.headings.map((heading) => <th>{heading}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            content.rows.map((row) => (
              <tr>
                <td>{row.feature}</td>
                <td class="pr-no">{row.alternative}</td>
                <td class="pr-yes">{row.pulpsense}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
