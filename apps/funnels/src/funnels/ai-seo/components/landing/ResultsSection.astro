---
import type { LandingContent } from "../../campaign-config";

type Props = { content: NonNullable<LandingContent["results"]> };

const { content } = Astro.props;
---

<!-- Proof / verified results -->
<section class="pr-section">
  <div class="pr-container pr-center">
    <h2 class="pr-h2">{content.heading}</h2>
    <p class="pr-sub">{content.intro}</p>
    <div class="pr-results">
      {
        content.items.map((item) => (
          <div class="pr-result-card">
            <span class="pr-result-badge">{item.badge}</span>
            <p class="pr-result-name">{item.name}</p>
            {item.metrics.map((metric) => {
              const [beforeArrow, afterArrow] = metric.value.split("→");
              return (
                <div class="pr-result-metric">
                  <span class="pr-metric-label">{metric.label}</span>
                  <span class="pr-metric-val">
                    {beforeArrow}
                    {afterArrow === undefined ? null : (
                      <>
                        <span class="pr-arrow">→</span>
                        {afterArrow}
                      </>
                    )}
                  </span>
                </div>
              );
            })}
            <p class="pr-result-summary">{item.summary}</p>
          </div>
        ))
      }
    </div>
    <div class="pr-rating-stars" aria-hidden="true">★★★★★</div>
    <p style="color: var(--pr-muted); margin: 0.25rem 0 0">
      <strong style="color: var(--pr-text)">{content.rating}</strong>{" "}
      {content.ratingLabel}
    </p>
  </div>
</section>
