---
import type { LandingContent } from "../../campaign-config";

type Props = { content: LandingContent["stickyCta"]; ctaPath: string };

const { content, ctaPath } = Astro.props;
---

<div class="pr-sticky-cta" aria-hidden="true">
  <a href={ctaPath} data-funnel-cta="mobile_sticky">{content.label}</a>
</div>
