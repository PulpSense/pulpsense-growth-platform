---
import type { LandingContent } from "../../campaign-config";

type Props = { content: LandingContent["faq"] };

const { content } = Astro.props;
---

<!-- FAQ -->
<section class="pr-section pr-section-gray">
  <div class="pr-container pr-center">
    <h2 class="pr-h2">{content.heading}</h2>
    <div class="pr-faq">
      {
        content.items.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
