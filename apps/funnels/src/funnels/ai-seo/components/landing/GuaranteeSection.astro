---
import type { LandingContent } from "../../campaign-config";

type Props = { content: LandingContent["guarantee"] };

const { content } = Astro.props;
---

<!-- Guarantee -->
<section class="pr-section">
  <div class="pr-container">
    <div class="pr-guarantee">
      <h2>
        <strong>{content.promise}</strong>{content.promiseSeparator}
        <strong>{content.timeframe}</strong>{content.titleSeparator}{
          content.titleSuffix
        }
      </h2>
      <p>
        {content.body}
      </p>
      <div class="pr-guarantee-pills">
        {
          content.pills.map((pill) => (
            <span class="pr-guarantee-pill">{pill}</span>
          ))
        }
      </div>
      {
        content.terms && (
          <div class="pr-guarantee-terms">
            <h3>{content.terms.heading}</h3>
            <ul>
              {content.terms.items.map((term) => (
                <li>{term}</li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</section>
