---
type Props = { ctaPath: string };

const { ctaPath } = Astro.props;
---

<!-- Offer stack -->
<section class="pr-section">
  <div class="pr-container pr-center">
    <h2 class="pr-h2">Everything Needed to Rank Across Google and AI</h2>
    <p class="pr-sub">
      The scope is built around your services, markets, current visibility, and
      competition. We handle the implementation.
    </p>
    <div class="pr-offer-card">
      <ul class="pr-offer-list">
        <li>
          <strong>Google Business Profile optimization</strong>, built around
          the exact &quot;money keywords&quot; customers search
        </li>
        <li>
          <strong>Listings on 50+ directories AI cross-checks</strong>, the
          trust signals ChatGPT and AI Overviews pull from
        </li>
        <li>
          <strong>Keyword-rich review system</strong>, turns your 5-star reviews
          into ranking fuel, not just stars
        </li>
        <li>
          <strong>Ongoing profile activity &amp; management</strong>, so Google
          never marks you inactive while competitors post
        </li>
        <li>
          <strong>AI-ready service content</strong>, structured so Google and AI
          can understand and recommend your business
        </li>
        <li>
          <strong>Monthly re-audits + a simple report</strong>, what moved,
          where you rank, and how many calls came in
        </li>
      </ul>
      <a class="pr-btn" href={ctaPath} data-funnel-cta="final"
        >Get Your Visibility Audit</a
      >
      <p class="pr-note">
        We work with one business per service category in each market.
      </p>
    </div>
  </div>
</section>
