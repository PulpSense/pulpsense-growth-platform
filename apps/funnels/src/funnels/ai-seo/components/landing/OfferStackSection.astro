---
import type { LandingContent } from "../../campaign-config";

type Props = { content: LandingContent["offer"]; ctaPath: string };

const { content, ctaPath } = Astro.props;
---

<!-- Offer stack -->
<section class="pr-section">
  <div class="pr-container pr-center">
    <h2 class="pr-h2">{content.heading}</h2>
    <p class="pr-sub">{content.intro}</p>
    <div class="pr-offer-card">
      <ul class="pr-offer-list">
        {
          content.items.map((item) => (
            <li>
              {item.before}
              <strong>{item.emphasis}</strong>
              {item.after}
            </li>
          ))
        }
      </ul>
      <a class="pr-btn" href={ctaPath} data-funnel-cta="final"
        >{content.ctaLabel}</a
      >
      <p class="pr-note">
        {content.note}
      </p>
    </div>
  </div>
</section>
