---
import type { LandingContent } from "../../campaign-config";

type Props = { content: LandingContent["marketShift"] };

const { content } = Astro.props;
---

<!-- Problem + stats -->
<section class="pr-section pr-section-gray">
  <div class="pr-container pr-center">
    <h2 class="pr-h2">{content.heading}</h2>
    <p class="pr-sub">{content.intro}</p>
    <div class="pr-stats">
      {
        content.stats.map((stat) => (
          <div>
            <div class="pr-stat-num">{stat.value}</div>
            <div class="pr-stat-lbl">{stat.label}</div>
          </div>
        ))
      }
    </div>
    <p class="pr-note" style="margin-top: 1.5rem">
      {content.note}
    </p>
  </div>
</section>
