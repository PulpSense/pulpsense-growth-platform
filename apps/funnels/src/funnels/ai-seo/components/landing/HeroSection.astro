---
import ClientLogoCarousel from "./ClientLogoCarousel.astro";
import { VisibilityDeckCarousel } from "./VisibilityDeckCarousel";
import type { LandingContent } from "../../campaign-config";

type Props = {
  content: LandingContent["hero"];
  ctaPath: string;
};

const { content, ctaPath } = Astro.props;
---

<div class="pr-bar">{content.callout}</div>

<div class="pr-hero-inner pr-center">
  {
    content.badge && (
      <div class="pr-badge">
        <span class="pr-stars" aria-hidden="true">
          <svg class="pr-star" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
          </svg>
          <svg class="pr-star" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
          </svg>
          <svg class="pr-star" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
          </svg>
          <svg class="pr-star" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
          </svg>
          <svg class="pr-star" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
          </svg>
        </span>
        <span class="pr-badge-copy">{content.badge}</span>
      </div>
    )
  }
  <h1 class="pr-h1">
    <span class="pr-accent">{content.promise}</span>{" "}
    <span class="pr-accent">{content.timeframePrefix}</span>{" "}
    <span class="pr-accent">{content.timeframe}</span>{content.titleSeparator}{
      content.titleSuffix
    }
  </h1>
  <p class="pr-lead">
    {content.lead}
  </p>
  {content.showDeck && <VisibilityDeckCarousel client:idle />}
  <a class="pr-btn" href={ctaPath} data-funnel-cta="hero">{content.ctaLabel}</a>
  <p class="pr-note">
    {content.note.before}<u>{content.note.emphasis}</u>{content.note.after}
  </p>
  {content.logoLabel && <ClientLogoCarousel label={content.logoLabel} />}
</div>
