---
import WistiaPlayer from "@/components/funnel/WistiaPlayer.astro";
---

<div class="pr-bar">👷 Proudly Serving Local Contractors Nationwide</div>

<div class="pr-hero-inner pr-center">
  <div class="pr-badge">
    <span class="pr-stars" aria-hidden="true">
      <svg class="pr-star" viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
        ></path>
      </svg>
      <svg class="pr-star" viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
        ></path>
      </svg>
      <svg class="pr-star" viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
        ></path>
      </svg>
      <svg class="pr-star" viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
        ></path>
      </svg>
      <svg class="pr-star" viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
        ></path>
      </svg>
    </span>
    <span
      style="
                font-size: clamp(0.72rem, 3vw, 0.875rem);
                font-weight: 600;
                color: #374151;
              "
      >Rated 4.9/5 by 500+ Local Contractors</span
    >
  </div>
  <h1 class="pr-h1">
    <span class="pr-accent">45 New Calls</span>{" "}in 90 Days for{" "}
    <span class="pr-accent">$297/mo</span>{" "}By Ranking #1 on Google Maps
    &amp; AI
  </h1>
  <p class="pr-lead">
    No setup fee. No ad spend. No shared leads. Month-to-month.{" "}
    <strong>Watch the video</strong>{" "}to see exactly how it works — price
    included.
  </p>
  <div class="pr-vsl-wrap">
    <WistiaPlayer mediaId="8py8vigtf1" label="Lead Oracle AI overview" />
  </div>
  <a class="pr-btn" href="#pr-funnel-form">See If You Qualify</a>
  <a class="pr-skip-call" href="/start" data-skip-call="hero"
    >Ready now? Skip the call — start your 7-day trial →</a
  >
  <p class="pr-note">
    <u>Over 200M people</u> now use ChatGPT every week to find local contractors—like
    you.
  </p>
</div>
