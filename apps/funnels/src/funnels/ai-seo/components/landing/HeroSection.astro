---
import WistiaPlayer from "@/components/funnel/WistiaPlayer.astro";
---

<div class="pr-bar">
  📌{" "}For established, high-trust regional service businesses
</div>

<div class="pr-hero-inner pr-center">
  <div class="pr-badge">
    <span class="pr-stars" aria-hidden="true">
      <svg class="pr-star" viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
        ></path>
      </svg>
      <svg class="pr-star" viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
        ></path>
      </svg>
      <svg class="pr-star" viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
        ></path>
      </svg>
      <svg class="pr-star" viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
        ></path>
      </svg>
      <svg class="pr-star" viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
        ></path>
      </svg>
    </span>
    <span
      style="
                font-size: clamp(0.72rem, 3vw, 0.875rem);
                font-weight: 600;
                color: #374151;
              "
      >Rated 4.9/5 by 500+ Service Business Owners</span
    >
  </div>
  <h1 class="pr-h1">
    <span class="pr-accent">45 New Calls</span>{" "}
    <span class="pr-accent">in</span>{" "}
    <span class="pr-accent">90 Days</span>{" "}by Ranking #1 Google &amp;
    ChatGPT
  </h1>
  <p class="pr-lead">
    Get found when people in your market are ready to call. No ad spend. No
    shared leads. The entire visibility system managed for you.
  </p>
  <div class="pr-vsl-wrap">
    <WistiaPlayer mediaId="8py8vigtf1" label="Lead Oracle AI overview" />
  </div>
  <a class="pr-btn" href="#pr-funnel-form">Get Your Visibility Audit</a>
  <p class="pr-note">
    <u>Over 200M people</u> use ChatGPT every week to decide which service businesses
    to trust.
  </p>
</div>
