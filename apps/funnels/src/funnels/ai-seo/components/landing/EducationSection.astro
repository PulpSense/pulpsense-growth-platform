---
import type { LandingContent } from "../../campaign-config";

type Props = { content: LandingContent["education"] };

const { content } = Astro.props;
---

<!-- This isn't SEO / Ads -->
<section class="pr-section pr-section-gray">
  <div class="pr-container pr-center">
    <h2 class="pr-h2">{content.heading}</h2>
    <p class="pr-sub">{content.intro}</p>
    <div class="pr-edu">
      {
        content.items.map((item) => (
          <div class="pr-edu-item">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
