---
import type { LandingContent } from "../../campaign-config";

type Props = { content: LandingContent["process"] };

const { content } = Astro.props;
---

<!-- How it works -->
<section class="pr-section pr-section-gray">
  <div class="pr-container pr-center">
    <h2 class="pr-h2">{content.heading}</h2>
    <p class="pr-sub">{content.intro}</p>
    <div class="pr-steps2">
      {
        content.steps.map((step, index) => (
          <div class="pr-step2">
            <span class="pr-step2-num">{index + 1}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
