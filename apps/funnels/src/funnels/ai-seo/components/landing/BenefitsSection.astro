---
import type { LandingContent } from "../../campaign-config";

type Props = { content: LandingContent["benefits"] };

const { content } = Astro.props;
---

<!-- Benefit cards -->
<section class="pr-section">
  <div class="pr-container pr-center">
    <h2 class="pr-h2">
      {content.heading}
    </h2>
    <p class="pr-sub">
      {content.intro}
    </p>
    <div class="pr-cards">
      {
        content.cards.map((card) => (
          <div class="pr-card2">
            <div class="pr-card2-ic">{card.icon}</div>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
