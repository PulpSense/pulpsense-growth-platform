const logoUrl = (asset: string) =>
  `/ai-seo/logos/${asset.replace(/-(webp|png|svg)$/u, ".$1")}`;
---

<section
  class="pr-client-logos"
  aria-label="Companies PulpSense has worked with"
>
  <p class="pr-client-logos-label">Trusted by Growing Businesses</p>
  <div class="pr-client-logos-window">
    <div class="pr-client-logos-track">
      {
        [...clients, ...clients].map((client, index) => (
          <div class="pr-client-logo" aria-hidden={index >= clients.length}>
            <img
              src={logoUrl(client.asset)}
              alt={index < clients.length ? `${client.name} logo` : ""}
              height={client.height}
              style={`height: ${client.height}px`}
              loading={index < 4 ? "eager" : "lazy"}
              decoding="async"
            />
          </div>
        ))
      }
    </div>
    <div
      class="pr-client-logos-fade pr-client-logos-fade-left"
      aria-hidden="true"
    >
    </div>
    <div
      class="pr-client-logos-fade pr-client-logos-fade-right"
      aria-hidden="true"
    >
    </div>
  </div>
</section>
