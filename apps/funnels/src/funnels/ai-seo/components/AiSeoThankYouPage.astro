    font-size: 0.875rem;
    font-weight: 500;
  }
  #pr-funnel .pr-container {
    width: 100%;
    max-width: 72rem;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1rem;
    padding-right: 1rem;
  }
  #pr-funnel .pr-container-md {
    max-width: 56rem;
  }
  #pr-funnel .pr-center {
    text-align: center;
  }
  #pr-funnel .pr-confirm-hero {
    padding: 2rem 1rem 0.5rem;
  }
  #pr-funnel .pr-confirm-h1 {
    margin: 0 auto 0.75rem;
    max-width: 22ch;
    font-size: clamp(1.5rem, 5vw, 2.125rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--pr-text);
  }
  #pr-funnel .pr-confirm-sub {
