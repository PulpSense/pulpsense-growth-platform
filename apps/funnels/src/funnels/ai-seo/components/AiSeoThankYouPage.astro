  }
  #pr-funnel .pr-bar {
    width: 100%;
    box-sizing: border-box;
    background: var(--pr-blue);
    color: #fff;
    text-align: center;
    padding: 0.5rem max(1rem, env(safe-area-inset-right)) 0.5rem
