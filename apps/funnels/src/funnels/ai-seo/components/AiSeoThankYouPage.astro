---
import { FunnelAnalytics, TrackingPixels } from "@/components/ui";
import {
  createBrowserTrackingConfig,
  parseDeploymentEnvironment,
} from "@/funnels/runtime-config";

const deploymentEnvironment = parseDeploymentEnvironment(
  import.meta.env.PUBLIC_PULPSENSE_ENVIRONMENT,
);
const pixels = createBrowserTrackingConfig({
  environment: deploymentEnvironment,
  metaPixelId: import.meta.env.PUBLIC_META_PIXEL_ID,
  productionMetaPixelId: "828948073514575",
});
---

<FunnelAnalytics
  client:interaction="idle"
  apiKey={import.meta.env.PUBLIC_POSTHOG_KEY}
  host={import.meta.env.PUBLIC_POSTHOG_HOST}
  funnelId="ai-seo"
  page="qualified"
/>
<TrackingPixels client:interaction="idle" pixels={pixels} interactionReady />
<style is:global>
  html {
    scroll-behavior: smooth;
    margin: 0;
    padding: 0;
    width: 100%;
    overflow-x: clip;
  }
  body {
    margin: 0 !important;
    padding: 0 !important;
    width: 100%;
    max-width: 100%;
    background: #f8fafc;
    overflow-x: clip;
  }
</style>
<style is:global>
  #pr-funnel,
  #pr-funnel * {
    box-sizing: border-box;
  }
  #pr-funnel {
    position: relative;
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow-x: clip;
    --pr-blue: #0080ff;
    --pr-blue-dark: #0066cc;
    --pr-text: #111827;
    --pr-muted: #6b7280;
    --pr-soft: #f3f4f6;
    --pr-border: #e5e7eb;
    font-family:
      system-ui,
      -apple-system,
      "Segoe UI",
      Roboto,
      Helvetica,
      Arial,
      sans-serif;
    color: var(--pr-text);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  #pr-funnel .pr-main {
    min-height: 100vh;
    background: linear-gradient(
      to bottom,
      #eff6ff 0%,
      #fff 40%,
      rgba(239, 246, 255, 0.35) 100%
