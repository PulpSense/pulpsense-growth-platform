---
import WistiaPlayer from "@/components/funnel/WistiaPlayer.astro";
import type { ThankYouContent } from "../../campaign-config";

type Props = { content: ThankYouContent["videos"] };

const { content } = Astro.props;
---

<h2 class="pr-videos-head">{content.heading}</h2>

<div class="pr-video-grid">
  {
    content.items.map((item) => (
      <article class="pr-video-card">
        <h3>{item.title}</h3>
        <div class="pr-video-frame">
          <WistiaPlayer mediaId={item.mediaId} label={item.label} />
        </div>
      </article>
    ))
  }
</div>
