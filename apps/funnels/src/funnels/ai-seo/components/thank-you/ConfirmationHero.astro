---
import { ThankYouDeckCarousel } from "./ThankYouDeckCarousel";
import type { ThankYouContent } from "../../campaign-config";

type Props = { content: ThankYouContent["confirmation"] };

const { content } = Astro.props;
---

<header class="pr-confirm-hero pr-center">
  <h1 class="pr-confirm-h1">
    {content.heading}
  </h1>
  <p class="pr-confirm-sub">
    {content.intro}
  </p>
  {
    content.showDeck && (
      <div class="video-wrap">
        <ThankYouDeckCarousel client:visible />
      </div>
    )
  }
</header>
