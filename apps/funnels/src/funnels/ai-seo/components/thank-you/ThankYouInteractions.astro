<div class="pr-lightbox" id="pr-lightbox" hidden>
  <button
    class="pr-lightbox-close"
    id="pr-lightbox-close"
    aria-label="Close enlarged review"
  >
    ×
  </button>
  <img id="pr-lightbox-img" src="" alt="" />
</div>
<script is:inline>
  /* Celebrate a confirmed booking without loading a confetti dependency. */
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    var canvas = document.createElement("canvas");
    var context = canvas.getContext("2d");
    if (!context) return;

    canvas.setAttribute("aria-hidden", "true");
    canvas.style.cssText =
      "position:fixed;inset:0;z-index:9999;width:100%;height:100%;pointer-events:none";
    document.body.appendChild(canvas);

    var colors = ["#2563eb", "#38bdf8", "#facc15", "#fb7185", "#ffffff"];
    var particles = [];
    var start = performance.now();
    var previousFrame = start;
    var duration = 3800;
    var isMobile = window.innerWidth < 768;
    var particleCount = isMobile ? 110 : 220;

    function resize() {
      var scale = Math.min(window.devicePixelRatio || 1, isMobile ? 1 : 2);
      canvas.width = Math.round(window.innerWidth * scale);
      canvas.height = Math.round(window.innerHeight * scale);
      context.setTransform(scale, 0, 0, scale, 0, 0);
    }

    function makeParticle(side) {
      var angle =
        side < 0
          ? -0.25 - Math.random() * 0.85
          : Math.PI + 0.25 + Math.random() * 0.85;
      var speed = 9 + Math.random() * 11;
      return {
        x: side < 0 ? -12 : window.innerWidth + 12,
        y: window.innerHeight * (0.18 + Math.random() * 0.3),
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
        size: 6 + Math.random() * 9,
        color: colors[Math.floor(Math.random() * colors.length)],
        rotation: Math.random() * Math.PI,
        spin: (Math.random() - 0.5) * 0.3,
      };
    }

    resize();
    for (var i = 0; i < particleCount; i += 1) {
      particles.push(makeParticle(i % 2 === 0 ? -1 : 1));
    }

    function removeCanvas() {
      window.removeEventListener("resize", resize);
      canvas.remove();
    }

    function draw(now) {
      var elapsed = now - start;
      if (elapsed >= duration) {
        removeCanvas();
        return;
      }

      /* Normalize motion to 60fps so dropped mobile frames do not slow physics. */
      var frameScale = (now - previousFrame) / (1000 / 60);
      previousFrame = now;

      context.clearRect(0, 0, window.innerWidth, window.innerHeight);
      context.globalAlpha = Math.min(1, (duration - elapsed) / 500);

      particles.forEach(function (particle) {
        var drag = Math.pow(0.992, frameScale);
        particle.x += (particle.vx * 0.992 * (1 - drag)) / (1 - 0.992);
        particle.vx *= drag;
        particle.y +=
          particle.vy * frameScale + (0.22 * frameScale * (frameScale + 1)) / 2;
        particle.vy += 0.22 * frameScale;
        particle.rotation += particle.spin * frameScale;

        context.save();
        context.translate(particle.x, particle.y);
        context.rotate(particle.rotation);
        context.fillStyle = particle.color;
        context.fillRect(
          -particle.size / 2,
          -particle.size / 4,
          particle.size,
          particle.size / 2,
        );
        context.restore();
      });

      requestAnimationFrame(draw);
    }

    window.addEventListener("resize", resize, { passive: true });
    requestAnimationFrame(draw);
  })();
</script>
<script is:inline>
  /* Review lightbox — tap a card to view the screenshot at reading size. */
  (function () {
    var box = document.getElementById("pr-lightbox");
    var boxImg = document.getElementById("pr-lightbox-img");
    var closeBtn = document.getElementById("pr-lightbox-close");
    if (!box || !boxImg || !closeBtn) return;
    function open(img) {
      /* Serve a higher-res render for reading (r_800 grid thumb → r_1200). */
      boxImg.src = img.src.replace("/r_800/", "/r_1200/");
      boxImg.alt = img.alt;
      box.hidden = false;
      document.body.style.overflow = "hidden";
    }
    function close() {
      box.hidden = true;
      boxImg.src = "";
      document.body.style.overflow = "";
    }
    document.querySelectorAll(".pr-review-card img").forEach(function (img) {
      img.closest(".pr-review-card").addEventListener("click", function () {
        open(img);
      });
    });
    box.addEventListener("click", function (e) {
      if (e.target !== boxImg) close();
    });
    closeBtn.addEventListener("click", close);
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && !box.hidden) close();
    });
  })();
</script>
<script is:inline>
  /* Review carousel auto-advance — only when cards overflow (mobile);
         hands control back permanently on any user interaction. */
  (function () {
    var track = document.getElementById("pr-reviews-track");
    if (!track) return;
    var stopped = false;
    var idx = 0;
    ["pointerdown", "wheel", "touchstart", "keydown"].forEach(function (ev) {
      track.addEventListener(
        ev,
        function () {
          stopped = true;
        },
        { passive: true },
      );
    });
    setInterval(function () {
      if (stopped || track.scrollWidth <= track.clientWidth + 8) return;
      var cards = track.children;
      if (!cards.length) return;
      idx = (idx + 1) % cards.length;
      track.scrollTo({
        left: cards[idx].offsetLeft - cards[0].offsetLeft,
        behavior: "smooth",
      });
    }, 4000);
  })();
</script>
