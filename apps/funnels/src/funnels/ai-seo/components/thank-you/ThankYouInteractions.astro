<div class="pr-lightbox" id="pr-lightbox" hidden>
  <button
    class="pr-lightbox-close"
    id="pr-lightbox-close"
    aria-label="Close enlarged review"
  >
    ×
  </button>
  <img id="pr-lightbox-img" src="" alt="" />
</div>
<script is:inline>
  /* Celebrate on the compositor so page scripts cannot make confetti stutter. */
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    var overlay = document.createElement("div");
    overlay.setAttribute("aria-hidden", "true");
    overlay.style.cssText =
      "position:fixed;inset:0;z-index:9999;overflow:hidden;pointer-events:none;contain:strict";
    document.body.appendChild(overlay);

    var colors = ["#2563eb", "#38bdf8", "#facc15", "#fb7185", "#ffffff"];
    var isMobile = window.innerWidth < 768;
    var particleCount = isMobile ? 60 : 96;
    var width = window.innerWidth;
    var height = window.innerHeight;

    for (var i = 0; i < particleCount; i += 1) {
      var particle = document.createElement("i");
      if (typeof particle.animate !== "function") {
        overlay.remove();
        return;
      }

      var side = i % 2 === 0 ? -1 : 1;
      var size = 6 + Math.random() * 8;
      var startX = side < 0 ? -24 : width + 24;
      var startY = height * (0.58 + Math.random() * 0.24);
      var middleX =
        width *
        (side < 0 ? 0.2 + Math.random() * 0.22 : 0.8 - Math.random() * 0.22);
      var middleY = Math.max(24, startY - 240 - Math.random() * 300);
      var endX =
        width *
        (side < 0 ? 0.55 + Math.random() * 0.4 : 0.05 + Math.random() * 0.4);
      var endY = height + 50;
      var startRotation = Math.random() * 360;
      var endRotation = startRotation + side * (540 + Math.random() * 720);

      particle.style.cssText =
        "position:absolute;left:0;top:0;border-radius:1px;will-change:transform,opacity";
      particle.style.width = size + "px";
      particle.style.height = size * 0.48 + "px";
      particle.style.background =
        colors[Math.floor(Math.random() * colors.length)];
      overlay.appendChild(particle);

      particle.animate(
        [
          {
            transform:
              "translate3d(" +
              startX +
              "px," +
              startY +
              "px,0) rotate(" +
              startRotation +
              "deg)",
            opacity: 1,
            easing: "cubic-bezier(0.12,0.7,0.25,1)",
          },
          {
            offset: 0.32,
            transform:
              "translate3d(" +
              middleX +
              "px," +
              middleY +
              "px,0) rotate(" +
              (startRotation + endRotation) / 2 +
              "deg)",
            opacity: 1,
            easing: "cubic-bezier(0.55,0.05,0.8,0.5)",
          },
          {
            transform:
              "translate3d(" +
              endX +
              "px," +
              endY +
              "px,0) rotate(" +
              endRotation +
              "deg)",
            opacity: 0,
          },
        ],
        {
          duration: 2400 + Math.random() * 800,
          delay: Math.random() * 150,
          fill: "forwards",
        },
      );
    }

    setTimeout(function () {
      overlay.remove();
    }, 3600);
  })();
</script>
<script is:inline>
  /* Review lightbox — tap a card to view the screenshot at reading size. */
  (function () {
    var box = document.getElementById("pr-lightbox");
    var boxImg = document.getElementById("pr-lightbox-img");
    var closeBtn = document.getElementById("pr-lightbox-close");
    if (!box || !boxImg || !closeBtn) return;
    function open(img) {
      /* Serve a higher-res render for reading (r_800 grid thumb → r_1200). */
      boxImg.src = img.src.replace("/r_800/", "/r_1200/");
      boxImg.alt = img.alt;
      box.hidden = false;
      document.body.style.overflow = "hidden";
    }
    function close() {
      box.hidden = true;
      boxImg.src = "";
      document.body.style.overflow = "";
    }
    document.querySelectorAll(".pr-review-card img").forEach(function (img) {
      img.closest(".pr-review-card").addEventListener("click", function () {
        open(img);
      });
    });
    box.addEventListener("click", function (e) {
      if (e.target !== boxImg) close();
    });
    closeBtn.addEventListener("click", close);
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && !box.hidden) close();
    });
  })();
</script>
<script is:inline>
  /* Review carousel auto-advance — only when cards overflow (mobile);
         hands control back permanently on any user interaction. */
  (function () {
    var track = document.getElementById("pr-reviews-track");
    if (!track) return;
    var stopped = false;
    var idx = 0;
    ["pointerdown", "wheel", "touchstart", "keydown"].forEach(function (ev) {
      track.addEventListener(
        ev,
        function () {
          stopped = true;
        },
        { passive: true },
      );
    });
    setInterval(function () {
      if (stopped || track.scrollWidth <= track.clientWidth + 8) return;
      var cards = track.children;
      if (!cards.length) return;
      idx = (idx + 1) % cards.length;
      track.scrollTo({
        left: cards[idx].offsetLeft - cards[0].offsetLeft,
        behavior: "smooth",
      });
    }, 4000);
  })();
</script>
