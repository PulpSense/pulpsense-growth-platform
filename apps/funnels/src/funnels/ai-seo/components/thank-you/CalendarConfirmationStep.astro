---
import type { ThankYouContent } from "../../campaign-config";

type Props = { content: ThankYouContent["calendar"] };

const { content } = Astro.props;
---

<div class="pr-step-card">
  <div class="pr-step-label">{content.stepLabel}</div>
  <h2>{content.heading}</h2>
  <p>
    {content.beforeConfirmation}<strong>{content.confirmationLabel}</strong>{
      content.afterConfirmation
    }
  </p>
  <figure class="pr-inbox-guide">
    <img
      class="pr-inbox-guide-img"
      src={content.imageSrc}
      alt={content.imageAlt}
      loading="lazy"
      decoding="async"
    />
  </figure>
</div>
