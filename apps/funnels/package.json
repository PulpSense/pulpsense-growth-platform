{
  "name": "@pulpsense/funnels",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:next": "next dev --turbopack",
    "build": "astro build",
    "build:next": "next build",
    "deploy:preview": "cross-env PUBLIC_PULPSENSE_ENVIRONMENT=preview pnpm build && wrangler pages deploy dist --project-name pulpsense-funnels-preview --branch issue-81",
    "start": "cross-env CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler pages dev -c wrangler.toml -c ../rate-limiter/wrangler.toml",
    "start:next": "next start",
    "build-prod": "run-s clean build",
    "check-parity": "node scripts/check-parity.mjs",
    "clean": "rimraf .astro dist",
    "lint": "eslint .",
    "format": "eslint . --fix && prettier 'src/**/*.astro' 'package.json' 'tsconfig.json' --write",
    "check-types": "astro check && tsc --noEmit --pretty"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@calcom/embed-react": "^1.5.3",
    "@pulpsense/contracts": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "classnames": "^2.5.1",
    "next": "^16.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/eslintrc": "^3.2.0",
    "@next/bundle-analyzer": "^16.1.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "jsdom": "^27.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "rimraf": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "wrangler": "^4.120.0"
  },
  "license": "ISC"
}
