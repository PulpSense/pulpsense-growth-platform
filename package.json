{
  "name": "pulpsense-growth-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @pulpsense/funnels dev",
    "dev:funnels": "pnpm --filter @pulpsense/funnels dev",
    "dev:automations": "pnpm --filter @pulpsense/automations dev",
    "build": "pnpm --filter @pulpsense/funnels build",
    "build-prod": "pnpm --filter @pulpsense/funnels build-prod",
    "check-parity": "pnpm --filter @pulpsense/funnels check-parity",
    "start": "pnpm --filter @pulpsense/funnels start",
    "lint": "eslint apps packages",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert 'always-fail Turnstile'",
    "test:e2e:turnstile-failure": "playwright test --grep 'always-fail Turnstile'",
    "qualify:release": "pnpm test && pnpm check-types && pnpm lint && pnpm build && pnpm check-parity && pnpm --filter @pulpsense/funnels check-release-performance",
    "format": "pnpm --filter @pulpsense/funnels format && prettier '**/*.{json,yaml,yml}' '!pnpm-lock.yaml' --write --ignore-path .gitignore",
    "format:check": "pnpm --filter @pulpsense/funnels format:check && prettier '**/*.{json,yaml,yml}' '!pnpm-lock.yaml' --check --ignore-path .gitignore",
    "check-types": "pnpm -r check-types",
    "prepare": "node -e \"if (process.env.NODE_ENV !== 'production') require('child_process').execFileSync('husky', {stdio: 'inherit'})\""
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.0",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.0.18"
  }
}
