{
  "name": "pulpsense-growth-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @pulpsense/funnels dev",
    "dev:funnels": "pnpm --filter @pulpsense/funnels dev",
    "dev:automations": "pnpm --filter @pulpsense/automations dev",
    "build": "pnpm --filter @pulpsense/funnels build",
    "build-prod": "pnpm --filter @pulpsense/funnels build-prod",
    "check-parity": "pnpm --filter @pulpsense/funnels check-parity",
    "start": "pnpm --filter @pulpsense/funnels start",
    "lint": "pnpm --filter @pulpsense/funnels lint",
    "test": "vitest run",
    "qualify:release": "pnpm test && pnpm check-types && pnpm lint && pnpm build && pnpm check-parity && pnpm --filter @pulpsense/funnels check-release-performance",
    "format": "pnpm --filter @pulpsense/funnels format && prettier '**/*.{json,yaml,yml}' '!pnpm-lock.yaml' --write --ignore-path .gitignore",
    "check-types": "pnpm -r check-types",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.0",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.0",
    "vitest": "^4.0.18"
  }
}
